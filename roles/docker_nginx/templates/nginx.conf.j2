# NGINX Configuration Template for Production Deployment
user www-data;
worker_processes auto;
worker_rlimit_nofile 100000;

# Events block
events {
    worker_connections 1024;
    multi_accept on;
}

# HTTP server block
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log main;
    error_log   /var/log/nginx/error.log warn;

    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    include /etc/nginx/conf.d/*.conf;
    include /etc/nginx/sites-enabled/*;

    # Enable Gzip
    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types text/plain text/css application/javascript application/json application/xml application/xml+rss text/javascript;

    # SSL configuration if enabled
    {% if ssl_enabled %}
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers 'EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH';

    ssl_certificate {{ ssl_certificate_path }};
    ssl_certificate_key {{ ssl_certificate_key_path }};
    ssl_dhparam {{ ssl_dhparam_path }};
    {% endif %}

    server {
        listen 80;
        server_name {{ nginx_server_name }};  # Dynamic server name from variables
        {% if ssl_enabled %}
        listen 443 ssl;
        {% endif %}

        access_log /var/log/nginx/{{ nginx_server_name }}-access.log;
        error_log  /var/log/nginx/{{ nginx_server_name }}-error.log;

        # Redirect HTTP to HTTPS if SSL is enabled
        {% if ssl_enabled %}
        location / {
            return 301 https://$host$request_uri;
        }
        {% endif %}

        # Main location block for proxying requests to upstream services
        location / {
            proxy_pass http://{{ upstream_server }};  # Upstream server variable
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_cache_bypass $http_upgrade;
        }

        # Healthcheck location (optional)
        location /health {
            access_log off;
            return 200 'OK';
        }

        # Custom error pages (Optional)
        error_page 404 /404.html;
        location = /404.html {
            root /usr/share/nginx/html;
            internal;
        }

        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
            internal;
        }

    }

    # Additional server blocks or configurations for other environments can go here.

}